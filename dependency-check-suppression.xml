<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
  <!-- 1. Ложное срабатывание: CVE относится к jackson-modules-java8, а не к annotations -->
  <suppress>
    <notes><![CDATA[CVE-2018-1000873 касается Jackson-Modules-Java8 (jsr310). Библиотека jackson-annotations 2.9.0 не затронута, CPE совпал только по производителю.]]></notes>
    <packageUrl regex="true">^pkg:maven/com\.fasterxml\.jackson\.core/jackson-annotations@2\.9\.0$</packageUrl>
    <cve>CVE-2018-1000873</cve>
  </suppress>

  <!-- 2. Принятый риск: транзитивная зависимость, уязвимая функция не вызывается -->
  <suppress>
    <notes><![CDATA[CVE-2021-29425: commons-io подтягивается транзитивно через commons-fileupload. Наш код не вызывает FileNameUtils.normalize. Риск принят до обновления зависимости.]]></notes>
    <packageUrl regex="true">^pkg:maven/commons-io/commons-io@2\.2$</packageUrl>
    <cve>CVE-2021-29425</cve>
  </suppress>

  <!-- 3. Ложное срабатывание по CPE: CVE относятся к веб-модулям Spring (MVC, WebFlux, RSocket, SpEL), которых в проекте нет -->
  <suppress>
    <notes><![CDATA[CVE затрагивают spring-webmvc, spring-webflux, spring-messaging и spring-expression. В проекте подключен только spring-core (подтверждено mvn dependency:tree). Сопоставление выполнено по CPE всего фреймворка. Пересмотреть при добавлении веб-модулей Spring.]]></notes>
    <filePath regex="true">.*/spring-core-6\.2\.19\.jar</filePath>
